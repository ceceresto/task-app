{
  "packages": {
    "apt": [
      "libpq-dev",
      "libssl-dev",
      "libzip-dev",
      "git",
      "unzip",
      "zip"
    ],
    "php_extensions": [
      "pdo_pgsql",
      "redis"
    ]
  },
  "steps": {
    "install:composer": "composer install --no-dev --optimize-autoloader --no-interaction",
    "install:node": "npm ci",
    "build": "npm run build"
  },
  "deploy": {
    "command": "php artisan optimize:clear && php artisan serve --host=0.0.0.0 --port=$PORT"
  }
}
